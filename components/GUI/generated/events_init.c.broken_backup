    s_flappy_score_label = lv_label_create(s_flappy_screen);
    lv_obj_align(s_flappy_score_label, LV_ALIGN_TOP_RIGHT, -10, 16);
    lv_obj_set_style_text_color(s_flappy_score_label, lv_color_hex(0xFFFFFF), 0);

